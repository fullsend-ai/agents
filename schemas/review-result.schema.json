{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-result.schema.json",
  "title": "Review Agent Result",
  "description": "Structured output from the review agent, validated by the harness before the post-script runs (ADR 0022).",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "pr_number", "repo"],
  "properties": {
    "action": {
      "type": "string",
      "enum": ["approve", "request-changes", "comment", "reject", "failure"]
    },
    "pr_number": { "type": "integer", "minimum": 1 },
    "repo": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+(/[a-zA-Z0-9._-]+)+$" },
    "head_sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$|^[0-9a-fA-F]{64}$" },
    "body": { "type": "string", "minLength": 1 },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" },
      "minItems": 1
    },
    "reason": {
      "type": "string",
      "enum": ["tool-failure", "missing-context", "ambiguous-findings", "token-limit", "time-budget"]
    },
    "dispositions": {
      "type": "array",
      "description": "One entry for every open finding id from the prior projection (status absent, open, or reclassified). Ids already resolved or dismissed by a human are closed and must not be answered. A reclassified entry needs a finding with the same id in findings; a dismissed_by_human entry is accepted only when the post-script verifies a resolved review thread from an eligible reviewer, and never for a high or critical finding. Omit on a first review.",
      "items": { "$ref": "#/$defs/disposition" }
    },
    "label_actions": {
      "$ref": "#/$defs/label_actions"
    },
    "risk_assessment": {
      "description": "Score and level must be consistent: 1=low, 2=moderate, 3=elevated, 4=high, 5=critical.",
      "type": "object",
      "required": ["score", "level", "rationale"],
      "properties": {
        "score": { "type": "integer", "minimum": 1, "maximum": 5 },
        "level": {
          "type": "string",
          "enum": ["low", "moderate", "elevated", "high", "critical"]
        },
        "tier1_signals": {
          "type": "array",
          "items": { "$ref": "#/$defs/risk_signal" }
        },
        "tier2_signals": {
          "type": "array",
          "items": { "$ref": "#/$defs/risk_signal" }
        },
        "tier3_signals": {
          "type": "array",
          "items": { "$ref": "#/$defs/risk_signal" }
        },
        "rationale": { "type": "string", "minLength": 1 },
        "degraded": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false,
      "allOf": [
        { "if": { "properties": { "score": { "const": 1 } } }, "then": { "properties": { "level": { "const": "low" } } } },
        { "if": { "properties": { "score": { "const": 2 } } }, "then": { "properties": { "level": { "const": "moderate" } } } },
        { "if": { "properties": { "score": { "const": 3 } } }, "then": { "properties": { "level": { "const": "elevated" } } } },
        { "if": { "properties": { "score": { "const": 4 } } }, "then": { "properties": { "level": { "const": "high" } } } },
        { "if": { "properties": { "score": { "const": 5 } } }, "then": { "properties": { "level": { "const": "critical" } } } }
      ]
    },
    "risk_gated": {
      "type": "boolean",
      "description": "Set by post-processing when a risk assessment downgrades the verdict. Not present in agent output — added by the harness post-script."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "action": { "const": "approve" } }, "required": ["action"] },
      "then": { "required": ["body", "head_sha"] }
    },
    {
      "if": { "properties": { "action": { "const": "request-changes" } }, "required": ["action"] },
      "then": { "required": ["body", "head_sha", "findings"] }
    },
    {
      "if": { "properties": { "action": { "const": "comment" } }, "required": ["action"] },
      "then": { "required": ["body", "head_sha"] }
    },
    {
      "if": { "properties": { "action": { "const": "reject" } }, "required": ["action"] },
      "then": { "required": ["body", "head_sha", "findings"] }
    },
    {
      "if": { "properties": { "action": { "const": "failure" } }, "required": ["action"] },
      "then": { "required": ["reason"] }
    },
    {
      "if": {
        "properties": { "action": { "const": "approve" } },
        "required": ["action"]
      },
      "then": {
        "not": {
          "properties": {
            "findings": {
              "contains": {
                "properties": { "category": { "const": "protected-path" } },
                "required": ["category"]
              }
            }
          },
          "required": ["findings"]
        }
      }
    }
  ],
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["severity", "category", "file", "description"],
      "properties": {
        "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] },
        "category": {
          "type": "string",
          "description": "Canonical dimension categories (the dimension table in skills/pr-review/references/re-review.md, mirrored by allowed_category in pre-review and post-review) plus the non-dimensional categories. Keep all copies in sync.",
          "enum": [
            "logic-error", "nil-deref", "off-by-one", "edge-case", "api-contract", "missing-test", "test-inadequate", "pattern-violation", "test-weakened", "test-removed", "mock-loosened", "assertion-weakened", "coverage-reduced", "test-poisoning", "split-payload", "stale-reference",
            "auth-bypass", "rbac-violation", "data-exposure", "privilege-escalation", "injection-vuln", "sandbox-escape", "xss", "ssrf", "insecure-deserialization", "prompt-injection", "unicode-steganography", "bidi-override", "homoglyph-attack", "instruction-smuggling", "fail-open", "permission-expansion", "permission-reduction", "role-escalation", "workflow-permission", "secret-exposure",
            "scope-exceeded", "tier-mismatch", "unauthorized-change", "scope-creep", "missing-authorization", "misleading-label", "design-direction", "complexity-ratio", "misplaced-abstraction", "architectural-conflict", "design-smell", "over-engineering", "under-engineering", "scope-bundling",
            "naming-convention", "error-handling-idiom", "api-shape", "code-organization", "doc-style", "pattern-inconsistency",
            "stale-doc", "missing-doc", "incorrect-doc", "incomplete-doc",
            "breaking-api", "breaking-schema", "breaking-config", "breaking-cli", "missing-deprecation", "missing-version-bump", "backward-incompatible",
            "protected-path", "provenance-warning", "scope-authorization-implicit", "sub-agent-failure"
          ]
        },
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "description": { "type": "string", "minLength": 1 },
        "remediation": { "type": "string" },
        "actionable": {
          "type": "boolean",
          "description": "When true with a non-empty remediation, routes the verdict to request-changes so the fix agent can address the finding automatically."
        },
        "id": {
          "type": "string",
          "pattern": "^f_[a-zA-Z0-9]+$",
          "description": "Stable id copied from the prior projection. Omit on a new finding; the post-script assigns f_ plus random hex. Do not derive it from the file, line, or text."
        }
      },
      "additionalProperties": false
    },
    "disposition": {
      "type": "object",
      "required": ["id", "status", "rationale", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^f_[a-zA-Z0-9]+$" },
        "status": {
          "type": "string",
          "enum": ["open", "resolved_by_change", "reclassified", "dismissed_by_human"]
        },
        "rationale": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "string",
          "description": "Code change or human resolution that supports the status. Empty only for open."
        }
      },
      "additionalProperties": false
    },
    "label_actions": {
      "type": "object",
      "required": ["reason", "actions"],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "Single sentence explaining why these labels are being applied or removed"
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["action", "label"],
            "properties": {
              "action": { "type": "string", "enum": ["add", "remove"] },
              "label": { "type": "string", "minLength": 1, "pattern": "^[a-zA-Z0-9._/: +-]+$" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "risk_signal": {
      "type": "object",
      "required": ["dimension", "value"],
      "properties": {
        "dimension": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
