{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "explore-result.schema.json",
  "title": "Exploration Result",
  "description": "Output schema for the explore agent — public research context for a work item. disposition=blocked_duplicate is a fail-fast stop when near-duplicate open work is found.",
  "type": "object",
  "required": [
    "input",
    "confidence",
    "summary"
  ],
  "properties": {
    "disposition": {
      "type": "string",
      "enum": [
        "complete",
        "needs_info",
        "blocked_duplicate"
      ],
      "description": "complete (or omit) = enough context to refine. needs_info = user-facing product questions remain; do not chain refine. blocked_duplicate = early stop on near-duplicate work."
    },
    "duplicate_of": {
      "type": "array",
      "description": "Near-duplicate open Features/Epics that triggered a block (or were overridden).",
      "items": {
        "type": "object",
        "required": [
          "issue_id",
          "summary",
          "reason"
        ],
        "properties": {
          "issue_id": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "input": {
      "type": "object",
      "required": [
        "source",
        "issue_id",
        "level",
        "summary"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "jira",
            "github",
            "text",
            "web"
          ]
        },
        "issue_id": {
          "type": "string"
        },
        "level": {
          "type": "string",
          "enum": [
            "outcome",
            "feature",
            "epic",
            "story",
            "task",
            "issue"
          ]
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "technical_landscape": {
      "type": "object",
      "properties": {
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "frameworks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "build_system": {
          "type": "string"
        },
        "deployment_targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "key_dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "role": {
                "type": "string"
              }
            }
          }
        },
        "existing_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "api_surface": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "test_infrastructure": {
          "type": "string"
        }
      }
    },
    "related_work": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "source",
          "issue_id",
          "title",
          "relevance"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "issue_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "relevance": {
            "type": "string"
          }
        }
      }
    },
    "impact_radius": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interfaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recent_commits": {
          "type": "integer",
          "minimum": 0
        },
        "stability": {
          "type": "string",
          "enum": [
            "active",
            "stable",
            "dormant"
          ]
        }
      }
    },
    "architectural_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "competitive_context": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "alternative": {
            "type": "string"
          },
          "approach": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dimension",
          "description"
        ],
        "properties": {
          "dimension": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "description": "Unresolved questions surfaced during exploration. blocking=true means the user must answer before refinement can proceed (user-facing product fact); blocking=false means the question is implementation-facing and downstream agents can resolve it.",
      "items": {
        "type": "object",
        "required": [
          "question",
          "blocking"
        ],
        "properties": {
          "question": {
            "type": "string"
          },
          "dimension": {
            "type": "string"
          },
          "blocking": {
            "type": "boolean"
          },
          "impact": {
            "type": "string"
          }
        }
      }
    },
    "confidence": {
      "type": "object",
      "required": [
        "overall"
      ],
      "properties": {
        "technical_landscape": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "related_work": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "architectural_constraints": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "competitive_context": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "requirements_clarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "overall": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "data_sources": {
      "type": "object",
      "description": "What data sources the explore agent actually accessed during this run.",
      "properties": {
        "accessed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Data sources that were successfully accessed (e.g., 'Jira (PROJ-123 + 3 linked issues)', 'GitHub (org/repo)', 'Web search (15 results)')."
        },
        "not_accessed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Data sources that were NOT available or accessed (e.g., 'GitLab repos (no access)', 'Internal docs / Google Drive', 'Slack conversations', 'CI/build data')."
        }
      }
    },
    "summary": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "blocked_duplicate"
          }
        },
        "required": [
          "disposition"
        ]
      },
      "then": {
        "required": [
          "disposition",
          "duplicate_of",
          "related_work"
        ],
        "properties": {
          "duplicate_of": {
            "minItems": 1
          },
          "related_work": {
            "minItems": 1
          }
        }
      },
      "else": {
        "required": [
          "technical_landscape",
          "related_work"
        ]
      }
    }
  ]
}
