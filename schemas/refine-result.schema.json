{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "refine-result.schema.json",
  "title": "Refinement Result",
  "description": "Output schema for the refine agent \u2014 complete decomposition plan, or blocked_duplicate early stop when near-duplicate open work is found.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input",
    "status",
    "confidence",
    "target_level",
    "children",
    "comment",
    "summary"
  ],
  "properties": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "key",
        "level",
        "summary"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "jira",
            "github",
            "gitlab",
            "text"
          ]
        },
        "key": {
          "type": "string"
        },
        "level": {
          "type": "string",
          "enum": [
            "outcome",
            "feature",
            "epic",
            "story",
            "task",
            "issue"
          ]
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "blocked_duplicate"
      ],
      "description": "complete = full plan. blocked_duplicate = fail-fast; do not chain critique."
    },
    "target_level": {
      "type": "string"
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall"
      ],
      "properties": {
        "scope_clarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "technical_grounding": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "acceptance_criteria": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "dependencies": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "sizing": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "overall": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "children": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "type",
          "description",
          "acceptance_criteria"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "Issue type matching the project's available types (lowercase). Common: feature, epic, story, task, sub-issue, bug, spike."
          },
          "parent_title": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": "string"
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "target"
              ],
              "properties": {
                "type": {
                  "type": "string"
                },
                "target": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "priority": {
            "type": "string"
          },
          "estimated_scope": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "deployment_target": {
            "type": "string"
          },
          "target_platform": {
            "type": "string",
            "enum": [
              "jira",
              "github",
              "gitlab"
            ],
            "description": "Platform to create this child on. Omit to inherit from parent."
          },
          "target_project": {
            "type": [
              "string",
              "null"
            ],
            "description": "Project/repo to create this child in. Only set when routing context is available."
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dimension",
          "question",
          "impact",
          "resolution"
        ],
        "properties": {
          "dimension": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "assumption_used": {
            "type": "string"
          },
          "resolution": {
            "type": "string",
            "description": "How this uncertainty should be surfaced to humans and critique. needs_human: only a stakeholder can unblock (sticky asks for reply). research_spike: covered by a Spike child \u2014 do not ask humans. assumed_default: plan proceeds on a stated default \u2014 sticky asks confirm/correct only.",
            "enum": [
              "needs_human",
              "research_spike",
              "assumed_default"
            ]
          },
          "spike_title": {
            "type": "string",
            "description": "When resolution is research_spike, the exact title of the Spike child that investigates this question."
          }
        }
      }
    },
    "proposed_description": {
      "type": "string",
      "maxLength": 20000
    },
    "dimensions_covered": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dimensions_missing": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncited_assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deployment_targets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "comment": {
      "type": "string",
      "maxLength": 4000
    },
    "summary": {
      "type": "string",
      "maxLength": 2000
    },
    "duplicate_of": {
      "type": "array",
      "description": "Near-duplicate open Features/Epics that triggered a block (or were overridden).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "summary",
          "reason"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked_duplicate"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "duplicate_of"
        ],
        "properties": {
          "duplicate_of": {
            "minItems": 1
          },
          "children": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "children": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
