export CLAUDE_CODE_USE_VERTEX=1
export ANTHROPIC_VERTEX_PROJECT_ID=${ANTHROPIC_VERTEX_PROJECT_ID}
export CLOUD_ML_REGION=${CLOUD_ML_REGION}
export GOOGLE_APPLICATION_CREDENTIALS=/tmp/.gcp-credentials.json
export GOOGLE_CLOUD_PROJECT=${GOOGLE_CLOUD_PROJECT}
# Base pin for the `sonnet` alias on the Claude Code runtime, which resolves
# aliases itself for the main model and for sub-agents. Unpinned, `sonnet`
# falls to the CLI default (claude-sonnet-4-5@20250929), which the fleet
# projects do not serve. Every harness here mounts this file, so it applies
# to all agents. A pinned alias has no fallback: if your Vertex project lacks
# this id, override it from a harness that composes this one (`base:` or
# `overlays:`) via env.sandbox.ANTHROPIC_DEFAULT_SONNET_MODEL, exported after
# .env.d (ADR 0055; the env.sandbox/host_files lint warning is expected).
# Bump together with fullsend's pi table (piModelAliases, fullsend#7028)
# and the explicit model IDs in skills/pr-review/sub-agents/*.md.
# `opus` and `haiku` stay unpinned: their CLI defaults are current, and
# fullsend#7031 defers the opus bump until the fleet projects serve Opus 5.
export ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-6
