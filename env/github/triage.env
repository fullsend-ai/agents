export ISSUE_URL="${GITHUB_ISSUE_URL}"
# The install's GitHub App prefix, which step 2e of agents/triage.md names
# (scripts/pre-triage.sh reads the same value on the host). Host
# files expand an unset variable to empty, so this is safe where it is
# unset: fullsend's harness-run job exports it, but the route-based triage
# job that runs the built-in triage agent does not yet
# (fullsend-ai/fullsend#9568).
export FULLSEND_APP_SET="${FULLSEND_APP_SET}"
