export ISSUE_URL="${GITHUB_ISSUE_URL}"
# The install's GitHub App prefix, for step 2e of agents/triage.md. Host
# files expand an unset variable to empty, so this is safe where it is
# unset: fullsend's triage and harness-run jobs export it, the triage job
# since fullsend-ai/fullsend#9575, so an older fullsend leaves it empty.
export FULLSEND_APP_SET="${FULLSEND_APP_SET}"
