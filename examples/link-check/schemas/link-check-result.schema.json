{
  "$id": "link-check-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Structured output from the link-check agent, consumed by scripts/post-link-check.sh.",
  "properties": {
    "comment": {
      "maxLength": 16384,
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "findings",
        "error"
      ],
      "type": "string"
    },
    "summary": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "status",
    "summary",
    "comment"
  ],
  "title": "link-check Agent Result",
  "type": "object"
}
